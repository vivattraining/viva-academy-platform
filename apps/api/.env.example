APP_ENV=development
API_PORT=8000
APP_URL=https://www.vivacareeracademy.com
TENANT_NAME=Viva Career Academy
TENANT_DOMAIN=www.vivacareeracademy.com
ALLOW_DEMO_AUTH=false

# Demo seed credentials (only active when ALLOW_DEMO_AUTH=true — local dev only).
# Set these to strong passwords; never enable ALLOW_DEMO_AUTH in production.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_OPS_EMAIL=
DEMO_OPS_PASSWORD=
DEMO_TRAINER_EMAIL=
DEMO_TRAINER_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# Required in production. Long random string (>= 32 chars) used to sign
# academy auth JWTs. Must match ACADEMY_JWT_SECRET on the frontend.
ACADEMY_JWT_SECRET=

# Required header for POST /auth/bootstrap-admin in production.
# Disable (unset) once the first admin exists.
ACADEMY_BOOTSTRAP_TOKEN=

# Comma-separated CORS allowlist. Defaults to APP_URL when unset.
CORS_ALLOWED_ORIGINS=https://www.vivacareeracademy.com
DATABASE_URL=sqlite:///./academy_os.db
REDIS_URL=redis://localhost:6379
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_HOST_EMAIL=tech@vivacareeracademy.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=

# Resend webhook signature secret. Required to verify the signature on
# /webhooks/resend in production. Without it the webhook will reject incoming
# delivery events (or in dev silently accept them).
RESEND_WEBHOOK_SECRET=

# Shared secret enforced by every /api/v1/cron/* handler. Vercel Cron sends
# it as `Authorization: Bearer <CRON_SECRET>`. REQUIRED IN PRODUCTION —
# without it, every cron handler refuses with 503 ("Cron not configured")
# and the scheduled jobs (module-unlock email, attendance-finalize,
# recording-deadline, email-retry) silently never run.
CRON_SECRET=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_APPLICATION_RECEIVED=
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
WHATSAPP_TEMPLATE_CLASS_REMINDER=

# Optional. When set, callers presenting `X-Readiness-Token: <value>` on
# GET /api/v1/readiness see the full integration breakdown (DB engine,
# razorpay/zoom/resend/whatsapp configured-flags, named blockers).
# Without this header (or without this env var being set), /readiness
# returns only mode/status/blocker_count — no per-integration topology
# leak to anonymous reconnaissance scans. Use a strong random string.
READINESS_TOKEN=
